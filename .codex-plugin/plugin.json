{
  "name": "academic-writing-assistant",
  "version": "0.3.0",
  "description": "面向中文科研作者的通用学术写作 Skill，支持论文润色、中英互译、审稿回复与保真核查。",
  "author": {
    "name": "Academic Writing Assistant contributors",
    "url": "https://github.com/LvvUP"
  },
  "homepage": "https://github.com/LvvUP/academic-writing-assistant",
  "repository": "https://github.com/LvvUP/academic-writing-assistant",
  "license": "AGPL-3.0-only",
  "keywords": [
    "agent-skills",
    "scientific-writing",
    "academic-writing",
    "research-paper",
    "translation",
    "polishing",
    "chinese-academic-writing",
    "reviewer-response",
    "rebuttal",
    "latex",
    "manuscript",
    "peer-review"
  ],
  "skills": "./skills/",
  "interface": {
    "displayName": "Academic Writing Assistant",
    "shortDescription": "论文润色、中英互译、审稿回复与保真核查",
    "longDescription": "面向中英文学术论文的通用 Skill。通过锁定区、承重语言与自由表层、L1/L2/L3 改动分级和重要改动台账，帮助作者核对事实、数值及证据边界。支持分层写作模式、来源核验、按研究类型审阅及本地机械检查；具体能力取决于宿主，实际兼容状态见仓库文档。",
    "developerName": "Academic Writing Assistant contributors",
    "category": "Productivity",
    "capabilities": [
      "Read",
      "Write"
    ],
    "defaultPrompt": [
      "请快速润色这段中文学术文本，保留事实、数值和限定条件。",
      "请把这段中文学术文本翻译成英文，保留 LaTeX、引用键及术语。",
      "请根据已提供证据起草审稿回复，区分已完成工作、计划与未知信息。"
    ],
    "brandColor": "#2563EB",
    "composerIcon": "./assets/logo/revision-compass.png",
    "logo": "./assets/logo/revision-compass.png"
  }
}
